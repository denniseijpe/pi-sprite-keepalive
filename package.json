{
  "name": "pi-sprite-keepalive",
  "version": "0.1.0",
  "description": "A pi extension that keeps a Sprite awake while the agent is working.",
  "type": "module",
  "main": "./index.ts",
  "exports": "./index.ts",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "sprite",
    "keepalive"
  ],
  "author": "Dennis Eijpe <dennis@de-programmeer.nl>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denniseijpe/pi-sprite-keepalive.git"
  }
}
